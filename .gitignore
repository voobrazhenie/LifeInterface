# --- credentials that must never be committed ---
# Service-account / Admin SDK keys bypass every Firestore security rule.
# (fitness/firebase-config.js is NOT secret and IS committed — see the note in it.)
service-account.json
*service-account*.json
*-adminsdk-*.json
.env
.env.*

# This repo is public. Never let progress photos or body metrics in here.
Photos/
photos/
*.jpeg
*.jpg
*.png
metrics.json
measurements.*

# App icons are the one intended exception — generated by tools/make-icons.mjs,
# no photographic content. Listed explicitly so the blanket *.png rule above
# keeps protecting everything else.
!fitness/icon-180.png
!fitness/icon-192.png
!fitness/icon-512.png

node_modules/
.DS_Store
Thumbs.db

# .claude/ is local tool config by default, except the project subagents and
# custom commands, which are meant to be part of the repo — see
# .claude/agents/*.md and .claude/commands/*.md.
.claude/*
!.claude/agents/
!.claude/agents/*.md
!.claude/commands/
!.claude/commands/*.md
